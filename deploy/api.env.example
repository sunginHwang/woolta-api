# 서버의 /etc/woolta/api.env 로 복사해 값을 채운다.
# 이 파일 자체는 예시라 레포에 있어도 되지만, 채운 값은 절대 커밋하지 않는다.
#
#   sudo mkdir -p /etc/woolta
#   sudo cp deploy/api.env.example /etc/woolta/api.env
#   sudo chmod 600 /etc/woolta/api.env   # DB 비밀번호가 들어간다
#   sudo chown <배포계정> /etc/woolta/api.env

PORT=4100

# DB — 세 도메인이 서로 다른 스키마를 쓴다
BLOG_DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/test"
WOOLBANK_DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/woolBank"
DASHBOARD_DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/dashboard"

# 세션 서명 키. 레거시와 같은 값이어야 기존 로그인이 유지된다.
AUTH_SECRET_TOKEN_KEY="CHANGE_ME"

# 쿠키를 .woolta.com 전체에서 공유한다(대시보드·blog·bank 가 한 세션을 쓴다)
AUTH_COOKIE_DOMAIN=".woolta.com"
AUTH_COOKIE_SAMESITE="lax"

# 이미지 업로드 — nginx(image.woolta.com)가 읽는 바로 그 디렉터리여야 한다.
# 다르면 업로드는 되는데 조회가 404 난다.
IMAGE_UPLOAD_PATH="/home/blog/post/upload/"
IMAGE_PUBLIC_URL="https://image.woolta.com"

# 소셜 로그인 provider (FE 의 NEXT_PUBLIC_* 와 짝을 이룬다)
GOOGLE_CLIENT_ID=""
KAKAO_APP_ID=""

# 레거시 Koa woolbankApi 를 내린 뒤에 켠다.
# 둘 다 켜져 있으면 정기지출이 이중 등록된다.
# ENABLE_WOOLBANK_CRON=1

# 레거시가 발급한 refresh 토큰을 거부한다. 레거시 종료 후 올린다.
# AUTH_REFRESH_STORE_STRICT=1

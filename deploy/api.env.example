# 서버의 /etc/woolta/api.env 로 복사해 값을 채운다.
# 이 파일 자체는 예시라 레포에 있어도 되지만, 채운 값은 절대 커밋하지 않는다.
#
#   sudo mkdir -p /etc/woolta
#   sudo cp deploy/api.env.example /etc/woolta/api.env
#   sudo chmod 600 /etc/woolta/api.env   # DB 비밀번호와 봇 토큰이 들어간다
#   sudo chown <배포계정> /etc/woolta/api.env

# 코드 기본값(app.ts)·pm2(ecosystem.config.cjs)와 같은 값이어야 한다.
# 다르면 앱은 떠도 deploy.sh 의 헬스체크가 엉뚱한 포트를 찔러 실패한다.
PORT=4500

# DB — 세 도메인이 서로 다른 스키마를 쓴다
BLOG_DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/test"
WOOLBANK_DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/woolBank"
DASHBOARD_DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/dashboard"

# 세션 서명 키. 레거시와 같은 값이어야 기존 로그인이 유지된다.
AUTH_SECRET_TOKEN_KEY="CHANGE_ME"

# 쿠키를 .woolta.com 전체에서 공유한다(대시보드·blog·bank 가 한 세션을 쓴다)
AUTH_COOKIE_DOMAIN=".woolta.com"
AUTH_COOKIE_SAMESITE="lax"

# 블로그 쓰기 권한. 미설정이면 createPost/updatePost/deletePost/sendPushToAll 이
# 전부 막힌다(fail-closed). woolBank user.id 를 쉼표로 구분한다.
BLOG_ADMIN_USER_IDS=""
# 글 작성자로 기록될 블로그 DB 의 user.no (외부 인증 붙기 전까지의 임시 신원)
BLOG_AUTHOR_USER_NO=1

# 이미지 업로드 — nginx(image.woolta.com)가 읽는 바로 그 디렉터리여야 한다.
# 다르면 업로드는 되는데 조회가 404 난다.
IMAGE_UPLOAD_PATH="/home/blog/post/upload/"
IMAGE_PUBLIC_URL="https://image.woolta.com"

# 봇 서버(aiho) 서버 간 인증. 미설정이면 Bearer 요청이 전부 거부된다(fail-closed).
# 토큰이 유출돼도 가계부까지 대행하지 못하도록 허용 경로 기본값은 캘린더 하나다.
WOOLTA_BOT_TOKEN=""
WOOLTA_BOT_USER_IDS=""
# WOOLTA_BOT_ALLOWED_PATHS="/calendar/graphql,/todo/graphql"

# 소셜 로그인 provider (FE 의 NEXT_PUBLIC_* 와 짝을 이룬다)
# 빠진 provider 는 그 로그인만 실패한다(fail-closed).
GOOGLE_CLIENT_ID=""
KAKAO_APP_ID=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# FE 가 진짜 크로스 오리진일 때만. 이 경우 AUTH_COOKIE_SAMESITE="none" 과 세트다.
# CORS_ORIGINS="https://woolta.com,https://blog.woolta.com"

# 레거시 woolBank 버킷리스트 이미지를 이 서버가 /uploads 로 서빙할 때만.
# WOOLBANK_UPLOAD_PATH="/home/woolbank/upload"

# 레거시가 발급한 refresh 토큰을 거부한다. 레거시 종료 후 올린다.
# AUTH_REFRESH_STORE_STRICT=1

# 참고: 정기지출 크론은 현재 app.ts 에서 주석 처리돼 있어 이 값만으로는 켜지지 않는다.
# ENABLE_WOOLBANK_CRON=1

{
  "compilerOptions": {
    /* 실행은 tsx(esbuild)가 담당 — tsc는 타입 체크 전용(noEmit) */
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,

    "typeRoots": ["./src/apps/woolBank/types", "./node_modules/@types"],

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  }
}

// article-curation 도메인 스키마 — dashboard DB (테이블 DDL: scripts/dashboardDdl.sql)
generator client {
  provider = "prisma-client"
  output   = "./generated/article"
}

datasource article {
  provider = "mysql"
}

model Article {
  @@map("article")

  id            String   @id @default(uuid()) @article.Char(36)
  userId        Int      @map("user_id")
  categoryId    String   @map("category_id") @article.Char(36)
  title         String
  url           String   @article.VarChar(2048)
  normalizedUrl String   @map("normalized_url") @article.VarChar(500)
  seo           Json?    // { title?, description?, imageUrl? }
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
}

model ArticleCategory {
  @@map("article_category")

  id        String   @id @default(uuid()) @article.Char(36)
  userId    Int      @map("user_id")
  name      String
  order     Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

// 주차·아티클당 1행 — WeeklyCuration 은 weekKey 그룹핑으로 조립
model ArticleCuration {
  @@map("article_curation")
  @@unique([userId, weekKey, articleId])

  id        String   @id @default(uuid()) @article.Char(36)
  userId    Int      @map("user_id")
  weekKey   String   @map("week_key") @article.VarChar(10)
  articleId String   @map("article_id") @article.Char(36)
  createdAt DateTime @default(now()) @map("created_at")
}

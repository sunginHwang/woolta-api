// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./generated/blog"

}

datasource blog {
  provider = "mysql"
}


model User {
  @@map("user")

  no        Int     @id @default(autoincrement())
  userId    String  @unique @map("user_id")
  userName  String? @map("user_name")
  nickName  String? @map("nick_name")
  email     String?
  password  String
  imageUrl  String @map("image_url")
  isAdmin   Boolean @default(false) @map("is_admin")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  boards    Board[]
}

model Board {
  @@map("board")

  id             Int      @id @default(autoincrement())
  title          String
  contents       String?  @blog.Text
  subDescription String?  @map("sub_description")
  views          Int      @default(0)
  userNo         Int      @map("user_no")
  categoryNo     Int      @map("category_no")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user     User          @relation(fields: [userNo], references: [no])
  category BoardCategory @relation(fields: [categoryNo], references: [no])
}

model BoardCategory {
  @@map("board_category")

  no           Int     @id @default(autoincrement())
  categoryName String  @map("category_name")
  boards       Board[]
}

/// 업로드 이력. 레거시 이름은 post_file 이지만 blog 전용이 아니다 —
/// 모든 앱의 업로드를 appType 으로 구분해 함께 적재한다(image 도메인).
/// 레거시 Spring(jar)이 같은 테이블에 쓰고 있어 새 컬럼은 DEFAULT 를 갖는다.
model PostFile {
  @@map("post_file")
  @@index([appType, createdAt], map: "idx_post_file_app_type_created_at")

  id             Int      @id @default(autoincrement())
  originFileName String   @map("origin_file_name")
  fileName       String   @map("file_name")
  fileDir        String   @map("file_dir")
  fileExt        String   @map("file_ext")
  fullPath       String   @map("full_path")
  size           Int
  /// 업로드한 앱. 기존 744건은 blog 에디터에서만 올라왔으므로 기본값이 blog 다.
  appType        String   @default("blog") @map("app_type")
  mimeType       String?  @map("mime_type")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
}

model WebPushSubscription {
  @@map("web_push_subscription")

  id        Int      @id @default(autoincrement())
  endPoint  String   @map("end_point") @blog.Text
  pushKey   String   @map("push_key")
  auth      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model WebPushKey {
  @@map("web_push_key")

  id         Int    @id @default(autoincrement())
  publicKey  String @map("public_key")
  privateKey String @map("private_key")
}


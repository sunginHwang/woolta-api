// todo 도메인 스키마 — dashboard DB (테이블 DDL: scripts/dashboardDdl.sql)
generator client {
  provider = "prisma-client-js"
  output   = "./generated/todo"
}

datasource todo {
  provider = "mysql"
  url      = env("DASHBOARD_DATABASE_URL")
}

model Todo {

  id          String    @id @default(uuid()) @todo.Char(36)
  userId      Int       @map("user_id")
  title       String
  memo        String    @todo.Text
  dueDate     String?   @map("due_date") @todo.VarChar(10)
  categoryId  String?   @map("category_id") @todo.Char(36)
  priority    String    @default("none") @todo.VarChar(10)
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  deletedAt   DateTime? @map("deleted_at")
  order       Int       @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("todo")
}

model TodoCategory {

  id        String   @id @default(uuid()) @todo.Char(36)
  userId    Int      @map("user_id")
  name      String
  order     Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("todo_category")
}

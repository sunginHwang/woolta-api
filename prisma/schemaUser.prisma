// user 도메인 전용 스키마 — 데이터는 woolbank DB의 user / user_share_code 테이블을 그대로 사용한다.
generator client {
  provider = "prisma-client"
  output   = "./generated/user"
}

datasource user {
  provider = "mysql"
}

model User {
  @@map("user")

  id         Int      @id @default(autoincrement())
  name       String
  email      String
  password   String
  loginType  String   @map("login_type")
  socialId   String   @map("social_id")
  profileImg String   @map("profile_img")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
}

model UserShareCode {
  @@map("user_share_code")

  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  shareCode String   @map("share_code")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

// refresh 토큰 저장소 — 무효화(로그아웃/탈취 대응)와 회전·재사용 감지를 위해 필요.
// 평문 토큰은 저장하지 않고 sha256 해시만 보관한다. DDL: scripts/userRefreshTokenDdl.sql
model UserRefreshToken {
  @@map("user_refresh_token")

  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  familyId  String    @map("family_id")
  tokenHash String    @unique @map("token_hash")
  loginType String    @map("login_type")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
}

  "scripts": {
    "start": "ts-node src/app.ts",
    "dev": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/app.ts",
    "generate": "graphql-codegen",
    "test": "echo \"Error: no test specified\" && exit 1",
    "codegenAll": "npm run codegenWoolBank && npm run codegenBlog && npm run codegenUser && npm run codegenTodo && npm run codegenMemo && npm run codegenArticle",
    "codegenBlog": "graphql-codegen --config codegenBlog.ts",
    "codegenWoolBank": "graphql-codegen --config codegenWoolBank.ts",
    "codegenUser": "graphql-codegen --config codegenUser.ts",
    "codegenTodo": "graphql-codegen --config codegenTodo.ts",
    "codegenMemo": "graphql-codegen --config codegenMemo.ts",
    "codegenArticle": "graphql-codegen --config codegenArticle.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",

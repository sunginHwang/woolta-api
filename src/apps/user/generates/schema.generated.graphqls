scalar DateTime

input LoginByShareCodeInput {
  shareCode: String!
}

input LoginBySocialInput {
  email: String
  imageUrl: String
  loginType: SocialLoginType!
  name: String

  """
  provider가 발급한 토큰. GOOGLE = id_token, KAKAO_TALK / FACEBOOK = access token.
  서버가 provider에 되물어 검증하며, 여기서 확인된 식별자만 socialId로 쓴다.
  """
  token: String!
}

type Mutation {
  loginByShareCode(input: LoginByShareCodeInput!): UserInfo!
  loginBySocial(input: LoginBySocialInput!): UserInfo!
  logout: Boolean!

  """refresh 쿠키로 세션 갱신(회전). 토큰 값은 인자로도 응답으로도 오가지 않고 쿠키로만 처리된다."""
  refreshSession: Boolean!
  upsertShareCode: String!
}

type Query {
  checkAccess: Int!
  getShareCode: String!
  me: UserInfo!
}

enum SocialLoginType {
  FACEBOOK
  GOOGLE
  KAKAO_TALK
}

type UserInfo {
  authType: String
  createdAt: DateTime!
  email: String!
  id: Int!
  loginType: String!
  name: String!
  profileImg: String!
  socialId: String!
  updatedAt: DateTime!
}
  isExpiration: Boolean!
  rate: Float!
  regularTransferDate: Int!
  savingType: SavingType!
  savingTypeId: Int!
  startDate: DateTime!
  taxType: String!
  title: String!
  updatedAt: DateTime!
  userId: Int!
}


type Account {
  amount: Int!
  createdAt: DateTime!
  currentAmount: Int!
  deposits: [Deposit!]!
  endDate: DateTime!
  id: ID!
  isExpiration: Boolean!
  rate: Float!
  regularTransferDate: Int!
  savingType: SavingType!
  savingTypeId: Int!
  startDate: DateTime!
  taxType: String!
  title: String!
  updatedAt: DateTime!
  userId: Int!
}

type AccountBook {
  accountBookCategory: AccountBookCategory!
  accountBookCategoryId: Int!
  amount: Int!
  createdAt: DateTime!
  id: ID!
  installmentMonth: Int
  isDisabledBudget: Boolean!
  isRegularExpenditure: Boolean!
  memo: String!
  paidInstallmentMonth: Int
  registerDateTime: DateTime!
  regularDate: Int
  title: String!
  type: AccountBookCategoryType!
  updatedAt: DateTime!
  userId: Int!
}

type AccountBookCategory {
  accountBookCategoryImage: AccountBookCategoryImage!
  accountBookCategoryImageId: Int!
  createdAt: DateTime!
  delYn: Boolean!
  id: ID!
  name: String!
  type: AccountBookCategoryType!
  updatedAt: DateTime!
  useStatistic: Boolean!
  userId: Int!
}

type AccountBookCategoryImage {
  createdAt: DateTime!
  id: ID!
  imageUrl: String!
  name: String!
  updatedAt: DateTime!
  userId: Int!
}

type AccountBookCategoryImageList {
  itemList: [AccountBookCategoryImage!]!
  totalCount: Int!
}

type AccountBookCategoryList {
  itemList: [AccountBookCategory!]!
  totalCount: Int!
}

enum AccountBookCategoryType {
  EXPENDITURE
  INCOME
}

type AccountBookList {
  itemList: [AccountBook!]!
  totalCount: Int!
}

type AccountList {
  itemList: [Account!]!
  totalCount: Int!
}

type BucketList {
  completeDate: DateTime!
  createdAt: DateTime!
  description: String!
  id: ID!
  imageUrl: String!
  isComplete: Boolean!
  thumbImageUrl: String!
  title: String!
  todoList: [BucketListTodo!]!
  updatedAt: DateTime!
  user: WoolBankUser
  userId: Int!
}

type BucketListSummary {
  completeDate: DateTime!
  completeTodoCount: Int!
  id: ID!
  isComplete: Boolean!
  thumbImageUrl: String!
  title: String!
  todoCount: Int!
  updatedAt: DateTime!
}

type BucketListSummaryList {
  itemList: [BucketListSummary!]!
  totalCount: Int!
}

type BucketListTodo {
  bucketList: BucketList
  bucketListId: Int!
  createdAt: DateTime!
  id: ID!
  isComplete: Boolean!
  title: String!
  updatedAt: DateTime!
  user: WoolBankUser
  userId: Int!
}

input BucketListTodoInput {
  isComplete: Boolean!
  title: String!
}

input CompleteAccountExpirationInput {
  id: ID!
}

input CompleteBucketListInput {
  id: ID!
}

input CreateAccountBookCategoryInput {
  accountBookCategoryImageId: Int!
  name: String!
  type: AccountBookCategoryType!
  useStatistic: Boolean!
}

input CreateAccountBookInput {
  amount: Int!
  categoryId: Int!
  installmentMonth: Int
  isDisabledBudget: Boolean
  memo: String
  registerDateTime: DateTime!
  scheduledPaymentDay: Int
  scheduledPaymentType: ScheduledPaymentType
  title: String!
  type: AccountBookCategoryType!
}

input CreateAccountInput {
  amount: Int!
  endDate: DateTime!
  rate: Float!
  regularTransferDate: Int!
  savingTypeId: Int!
  startDate: DateTime!
  taxType: String!
  title: String!
}

input CreateBucketListInput {
  completeDate: DateTime!
  description: String!
  imageUrl: String
  thumbImageUrl: String
  title: String!
  todoList: [BucketListTodoInput!]
}

input CreateBucketListTodoInput {
  bucketListId: Int!
  isComplete: Boolean!
  title: String!
}

input CreateDepositInput {
  accountId: Int!
  amount: Int!
  depositDate: DateTime
}

input CreateRegularExpenditureInput {
  amount: Int!
  categoryId: Int!
  isAutoExpenditure: Boolean!
  regularDate: Int!
  title: String!
}

type CustomRegularExpenditure {
  accountBookCategory: AccountBookCategory!
  accountBookCategoryId: Int!
  amount: Int!
  createdAt: DateTime!
  id: ID!
  isAutoExpenditure: Boolean!
  regularDate: Int!
  regularExpenditureDay: DateTime!
  title: String!
  updatedAt: DateTime!
  userId: Int!
}

scalar DateTime

input DeleteAccountBookCategoryInput {
  id: ID!
}

input DeleteAccountBookInput {
  id: ID!
}

input DeleteAccountInput {
  id: ID!
}

input DeleteBucketListInput {
  id: ID!
}

input DeleteBucketListTodoInput {
  todoId: ID!
}

input DeleteRegularExpenditureInput {
  id: ID!
}

type Deposit {
  account: Account
  accountId: Int!
  amount: Int!
  createdAt: DateTime!
  depositDate: DateTime!
  id: ID!
  prevTotalAmount: Int!
  updatedAt: DateTime!
  userId: Int!
}

type MainInfo {
  accounts: [Account!]!
  bucketList: [BucketListSummary!]!
  totalSavedAmount: Int!
  totalSavedAmountExceptCurrentMonth: Int!
}

type Mutation {
  completeAccountExpiration(input: CompleteAccountExpirationInput!): Boolean!
  completeBucketList(input: CompleteBucketListInput!): Boolean!
  createAccount(input: CreateAccountInput!): Account!
  createAccountBook(input: CreateAccountBookInput!): AccountBook!
  createAccountBookCategory(input: CreateAccountBookCategoryInput!): AccountBookCategory!
  createBucketList(input: CreateBucketListInput!): BucketList!
  createBucketListTodo(input: CreateBucketListTodoInput!): BucketListTodo!
  createDeposit(input: CreateDepositInput!): Deposit!
  createRegularExpenditure(input: CreateRegularExpenditureInput!): RegularExpenditure!
  deleteAccount(input: DeleteAccountInput!): Boolean!
  deleteAccountBook(input: DeleteAccountBookInput!): Boolean!
  deleteAccountBookCategory(input: DeleteAccountBookCategoryInput!): Boolean!
  deleteBucketList(input: DeleteBucketListInput!): Boolean!
  deleteBucketListTodo(input: DeleteBucketListTodoInput!): Boolean!
  deleteRegularExpenditure(input: DeleteRegularExpenditureInput!): Boolean!
  updateAccountBook(input: UpdateAccountBookInput!): AccountBook!
  updateBucketList(input: UpdateBucketListInput!): BucketList!
  updateBucketListTodoComplete(input: UpdateBucketListTodoCompleteInput!): BucketListTodo!
}

type Query {
  account(id: ID!): Account
  accountBook(id: ID!): AccountBook
  accountBookCategoryImageList: AccountBookCategoryImageList!
  accountBookCategoryList: AccountBookCategoryList!
  accountBookList(dateTime: DateTime!): AccountBookList!
  accountList(limitCount: Int): AccountList!
  bucketList(id: ID!): BucketList
  bucketListSummaryList(limitCount: Int): BucketListSummaryList!
  getAccountBookStatisticList(endDate: DateTime!, startDate: DateTime!, type: AccountBookCategoryType!): StatisticList!
  getAccountLastUpdatedDate: DateTime!
  getBucketListItemLastUpdatedDate(id: ID!): DateTime!
  getBucketListLastUpdatedDate: DateTime!
  mainInfo: MainInfo!
  regularExpenditureGroupList(limitCount: Int): RegularExpenditureGroupList!
}

type RegularExpenditure {
  accountBookCategory: AccountBookCategory!
  accountBookCategoryId: Int!
  amount: Int!
  createdAt: DateTime!
  id: ID!
  isAutoExpenditure: Boolean!
  regularDate: Int!
  title: String!
  updatedAt: DateTime!
  userId: Int!
}

type RegularExpenditureGroup {
  imageUrl: String!
  list: [CustomRegularExpenditure!]!
  name: String!
  type: AccountBookCategoryType!
}

type RegularExpenditureGroupList {
  itemList: [RegularExpenditureGroup!]!
  totalCount: Int!
}

type SavingType {
  createdAt: DateTime!
  id: ID!
  name: String!
  type: String!
  updatedAt: DateTime!
}

enum ScheduledPaymentType {
  INSTALLMENT
  REPEAT
}

type Statistic {
  amount: Int!
  categoryId: String!
  categoryName: String!
  list: [StatisticItem!]!
  percentage: Float!
  useStatistic: Boolean!
}

type StatisticItem {
  amount: Int!
  registerDateTime: DateTime!
  title: String!
}

type StatisticList {
  itemList: [Statistic!]!
  totalCount: Int!
}

input UpdateAccountBookInput {
  amount: Int
  categoryId: Int
  id: ID!
  isDisabledBudget: Boolean
  memo: String
  registerDateTime: DateTime
  title: String
  type: AccountBookCategoryType
}

input UpdateBucketListInput {
  completeDate: DateTime!
  description: String!
  id: ID!
  imageUrl: String
  thumbImageUrl: String
  title: String!
}

input UpdateBucketListTodoCompleteInput {
  isComplete: Boolean!
  todoId: ID!
}

type UserShareCode {
  createdAt: DateTime!
  id: ID!
  shareCode: String!
  updatedAt: DateTime!
  userId: Int!
}

type WoolBankUser {
  accountBookCategories: [AccountBookCategory!]!
  accountBookCategoryImages: [AccountBookCategoryImage!]!
  accountBooks: [AccountBook!]!
  accounts: [Account!]!
  bucketLists: [BucketList!]!
  createdAt: DateTime!
  deposits: [Deposit!]!
  email: String!
  id: ID!
  loginType: String!
  name: String!
  profileImg: String!
  regularExpenditures: [RegularExpenditure!]!
  socialId: String!
  todos: [BucketListTodo!]!
  updatedAt: DateTime!
}
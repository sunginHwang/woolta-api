}

input CompleteAccountExpirationInput {
  id: ID!
}

input CompleteBucketListInput {
  id: ID!
}

input CreateAccountBookCategoryInput {
  accountBookCategoryImageId: Int!
  name: String!
  type: AccountBookCategoryType!
  useStatistic: Boolean!
}

input CreateAccountBookInput {
  amount: Int!
  categoryId: Int!
  installmentMonth: Int
  isDisabledBudget: Boolean
  memo: String
  registerDateTime: DateTime!
  scheduledPaymentDay: Int
  scheduledPaymentType: ScheduledPaymentType
  title: String!
  type: AccountBookCategoryType!
}

input CreateAccountBookItemInput {
  amount: Int!
  categoryId: Int!
  isDisabledBudget: Boolean
  memo: String
  registerDateTime: DateTime!
  title: String!
  type: AccountBookCategoryType!
}

"""
카드 내역서 벌크 등록. 항목은 단건 생성과 같은 입력을 쓴다.
정기지출/할부(scheduledPayment*)는 받지 않는다 — 내역서 한 줄은 이미 승인된 개별 거래이고,
벌크로 정기지출을 만들면 같은 지출이 매달 자동 생성돼 중복이 된다.
"""
input CreateAccountBookListInput {
  itemList: [CreateAccountBookItemInput!]!
}

type CreateAccountBookListResult {
  """실제로 저장된 건수"""
  createdCount: Int!
  itemList: [AccountBook!]!
}

input CreateAccountInput {
  amount: Int!
  endDate: DateTime!
  rate: Float!
  regularTransferDate: Int!
  savingTypeId: Int!
  startDate: DateTime!
  taxType: String!
  title: String!
}

input CreateBucketListInput {
  completeDate: DateTime!
  description: String!
  imageUrl: String
  thumbImageUrl: String
  title: String!
  todoList: [BucketListTodoInput!]
}

input CreateBucketListTodoInput {
  bucketListId: Int!
  isComplete: Boolean!
  title: String!
}

input CreateDepositInput {
  accountId: Int!
  amount: Int!
  depositDate: DateTime
}

input CreateRegularExpenditureInput {
  amount: Int!
  categoryId: Int!
  isAutoExpenditure: Boolean!
  regularDate: Int!
  title: String!
}

input CreateWoolBankNotificationInput {
  content: String!
  kind: String!

  """false 면 알림함에만 저장하고 푸시는 보내지 않는다. 기본 true"""
  sendPush: Boolean = true
  summary: String!
  title: String!
}

type CustomRegularExpenditure {
  accountBookCategory: AccountBookCategory!
  accountBookCategoryId: Int!
  amount: Int!
  createdAt: DateTime!
  id: ID!
  isAutoExpenditure: Boolean!
  regularDate: Int!
  regularExpenditureDay: DateTime!
  title: String!
  updatedAt: DateTime!
  userId: Int!
}

scalar DateTime

input DeleteAccountBookCategoryInput {
  id: ID!
}

input DeleteAccountBookInput {
  id: ID!
}

input DeleteAccountInput {
  id: ID!
}

input DeleteBucketListInput {
  id: ID!
}

input DeleteBucketListTodoInput {
  todoId: ID!
}

input DeleteRegularExpenditureInput {
  id: ID!
}

type Deposit {
  account: Account
  accountId: Int!
  amount: Int!
  createdAt: DateTime!
  depositDate: DateTime!
  id: ID!
  prevTotalAmount: Int!
  updatedAt: DateTime!
  userId: Int!
}

type MainInfo {
  accounts: [Account!]!
  bucketList: [BucketListSummary!]!
  totalSavedAmount: Int!
  totalSavedAmountExceptCurrentMonth: Int!
}

input MarkWoolBankNotificationReadInput {
  id: ID!
}

type Mutation {
  completeAccountExpiration(input: CompleteAccountExpirationInput!): Boolean!
  completeBucketList(input: CompleteBucketListInput!): Boolean!
  createAccount(input: CreateAccountInput!): Account!
  createAccountBook(input: CreateAccountBookInput!): AccountBook!
  createAccountBookCategory(input: CreateAccountBookCategoryInput!): AccountBookCategory!
  createAccountBookList(input: CreateAccountBookListInput!): CreateAccountBookListResult!
  createBucketList(input: CreateBucketListInput!): BucketList!
  createBucketListTodo(input: CreateBucketListTodoInput!): BucketListTodo!
  createDeposit(input: CreateDepositInput!): Deposit!
  createRegularExpenditure(input: CreateRegularExpenditureInput!): RegularExpenditure!

  """
  알림함에 한 건을 저장하고(sendPush 면) 이 계정의 모든 기기로 푸시를 보낸다. 푸시 클릭은 /notifications/{id} 로 간다.
  aiho 같은 봇이 봇 인증(x-woolta-user-id)으로 호출한다. 공유코드 세션의 기기도 같은 userId 라 함께 받는다.
  """
  createWoolBankNotification(input: CreateWoolBankNotificationInput!): WoolBankNotification!
  deleteAccount(input: DeleteAccountInput!): Boolean!
  deleteAccountBook(input: DeleteAccountBookInput!): Boolean!
  deleteAccountBookCategory(input: DeleteAccountBookCategoryInput!): Boolean!
  deleteBucketList(input: DeleteBucketListInput!): Boolean!
  deleteBucketListTodo(input: DeleteBucketListTodoInput!): Boolean!
  deleteRegularExpenditure(input: DeleteRegularExpenditureInput!): Boolean!
  markAllWoolBankNotificationRead: Boolean!
  markWoolBankNotificationRead(input: MarkWoolBankNotificationReadInput!): WoolBankNotification!

  """주간 예산 생성·수정(upsert). 공유코드 세션은 불가(requireRealUser)."""
  saveWeeklyBudget(input: SaveWeeklyBudgetInput!): WeeklyBudget!

  """테스트 알림. endpoint 를 주면 그 기기로만, 없으면 이 계정의 모든 기기로 보낸다. 공유코드 세션도 허용."""
  sendWoolBankTestPush(input: SendWoolBankTestPushInput): Boolean!

  """
  현재 기기의 Web Push 구독을 등록한다. endpoint 기준 upsert 라 재구독(pushsubscriptionchange)도 같은 뮤테이션을 쓴다.
  공유코드 세션도 허용 — 세션의 userId 가 원 계정이라, 원 계정 알림을 공유코드로 들어온 기기도 함께 받는다.
  """
  subscribeWoolBankPush(input: SubscribeWoolBankPushInput!): Boolean!

  """공유코드 세션도 허용 (자기 기기 구독만 지운다)"""
  unsubscribeWoolBankPush(input: UnsubscribeWoolBankPushInput!): Boolean!
  updateAccountBook(input: UpdateAccountBookInput!): AccountBook!
  updateBucketList(input: UpdateBucketListInput!): BucketList!
  updateBucketListTodoComplete(input: UpdateBucketListTodoCompleteInput!): BucketListTodo!

  """알림 종류 설정은 계정 단위라 원 계정 로그인만 바꿀 수 있다"""
  updateWoolBankPushSetting(input: UpdateWoolBankPushSettingInput!): WoolBankPushSetting!
}

type Query {
  account(id: ID!): Account
  accountBook(id: ID!): AccountBook
  accountBookCategoryImageList: AccountBookCategoryImageList!
  accountBookCategoryList: AccountBookCategoryList!
  accountBookList(dateTime: DateTime!): AccountBookList!
  accountList(limitCount: Int): AccountList!
  bucketList(id: ID!): BucketList
  bucketListSummaryList(limitCount: Int): BucketListSummaryList!

  """
  카테고리별 통계. onlyUseStatistic 이 true 면 통계 제외 카테고리(useStatistic=false)를 목록에서 빼고,
  비중(percentage)도 남은 항목의 합계를 분모로 계산한다. 기본값 false 는 전체 기준이다.
  """
  getAccountBookStatisticList(endDate: DateTime!, onlyUseStatistic: Boolean = false, startDate: DateTime!, type: AccountBookCategoryType!): StatisticList!
  getAccountLastUpdatedDate: DateTime!
  getBucketListItemLastUpdatedDate(id: ID!): DateTime!
  getBucketListLastUpdatedDate: DateTime!

  """푸시 상태. endpoint 를 주면 그 기기가 이 유저 구독으로 등록돼 있는지(isSubscribed)도 함께 준다."""
  getWoolBankPushStatus(endpoint: String): WoolBankPushStatus!
  getWoolBankUnreadNotificationCount: Int!
  mainInfo: MainInfo!
  regularExpenditureGroupList(limitCount: Int): RegularExpenditureGroupList!

  """주간 예산 조회. 설정 안 되어 있으면 amount 0 으로 응답."""
  weeklyBudget: WeeklyBudget!

  """
  해당 주차(월~일)의 예산 사용 현황. dateTime 생략 시 이번 주.
  주의: is_disabled_budget=true(적금·보험 등 정기지출)와 수입(income)은 사용액에서 제외한다.
  """
  weeklyBudgetUsage(dateTime: DateTime): WeeklyBudgetUsage!
  woolBankNotification(id: ID!): WoolBankNotification

  """최신순. limitCount 기본 50"""
  woolBankNotificationList(limitCount: Int): WoolBankNotificationList!
}

type RegularExpenditure {
  accountBookCategory: AccountBookCategory!
  accountBookCategoryId: Int!
  amount: Int!
  createdAt: DateTime!
  id: ID!
  isAutoExpenditure: Boolean!
  regularDate: Int!
  title: String!
  updatedAt: DateTime!
  userId: Int!
}

type RegularExpenditureGroup {
  imageUrl: String!
  list: [CustomRegularExpenditure!]!
  name: String!
  type: AccountBookCategoryType!
}

type RegularExpenditureGroupList {
  itemList: [RegularExpenditureGroup!]!
  totalCount: Int!
}

input SaveWeeklyBudgetInput {
  """한 주 예산 금액(원). 0 이상."""
  amount: Int!
}

type SavingType {
  createdAt: DateTime!
  id: ID!
  name: String!
  type: String!
  updatedAt: DateTime!
}

enum ScheduledPaymentType {
  INSTALLMENT
  REPEAT
}

input SendWoolBankTestPushInput {
  """이 기기(구독)로만 보낸다"""
  endpoint: String
}

type Statistic {
  amount: Int!
  categoryId: String!
  categoryName: String!
  list: [StatisticItem!]!
  percentage: Float!
  useStatistic: Boolean!
}

type StatisticItem {
  amount: Int!
  registerDateTime: DateTime!
  title: String!
}

type StatisticList {
  itemList: [Statistic!]!
  totalCount: Int!
}

input SubscribeWoolBankPushInput {
  auth: String!
  endpoint: String!

  """PushSubscription.expirationTime — 대부분 null"""
  expirationTime: DateTime
  p256dh: String!
  userAgent: String
}

input UnsubscribeWoolBankPushInput {
  endpoint: String!
}

input UpdateAccountBookInput {
  amount: Int
  categoryId: Int
  id: ID!
  isDisabledBudget: Boolean
  memo: String
  registerDateTime: DateTime
  title: String
  type: AccountBookCategoryType
}

input UpdateBucketListInput {
  completeDate: DateTime!
  description: String!
  id: ID!
  imageUrl: String
  thumbImageUrl: String
  title: String!
}

input UpdateBucketListTodoCompleteInput {
  isComplete: Boolean!
  todoId: ID!
}

input UpdateWoolBankPushSettingInput {
  regularExpenditure: Boolean!
}

type UserShareCode {
  createdAt: DateTime!
  id: ID!
  shareCode: String!
  updatedAt: DateTime!
  userId: Int!
}

type WeeklyBudget {
  """한 주 예산 금액(원). 미설정이면 0."""
  amount: Int!
}

type WeeklyBudgetUsage {
  """설정된 주간 예산(원). 미설정이면 0."""
  budget: Int!

  """해당 주차 종료일(일요일 23:59:59.999)."""
  endDate: DateTime!

  """예산 대비 사용 비율(%). 예산 0 이면 0. 반올림 정수."""
  percentage: Int!

  """남은 예산(원). budget - spent. 음수 가능(초과 지출)."""
  remaining: Int!

  """해당 주차 사용액(원). 수입·예산제외 항목 제외."""
  spent: Int!

  """해당 주차 시작일(월요일 00:00)."""
  startDate: DateTime!
}

type WoolBankNotification {
  """상세 페이지 본문. 줄바꿈 포함 plain text"""
  content: String!
  createdAt: DateTime!
  id: ID!

  """
  알림 종류. 푸시 topic/tag 로도 쓴다 (예: DAILY_DIGEST, WEEKLY_DIGEST, EVENING_REMINDER, REGULAR_EXPENDITURE)
  """
  kind: String!
  readAt: DateTime

  """푸시 본문 겸 목록 미리보기 (255자 이내)"""
  summary: String!

  """푸시 제목 (100자 이내)"""
  title: String!
}

type WoolBankNotificationList {
  itemList: [WoolBankNotification!]!
  totalCount: Int!
}

type WoolBankPushSetting {
  """정기지출 결제 전날 알림"""
  regularExpenditure: Boolean!
}

type WoolBankPushStatus {
  """질의한 endpoint 가 이 유저의 구독으로 등록돼 있는지. endpoint 를 안 주면 false."""
  isSubscribed: Boolean!
  setting: WoolBankPushSetting!

  """이 유저가 등록한 기기(구독) 수"""
  subscriptionCount: Int!
}

type WoolBankUser {
  accountBookCategories: [AccountBookCategory!]!
  accountBookCategoryImages: [AccountBookCategoryImage!]!
  accountBooks: [AccountBook!]!
  accounts: [Account!]!
  bucketLists: [BucketList!]!
  createdAt: DateTime!
  deposits: [Deposit!]!
  email: String!
  id: ID!
  loginType: String!
  name: String!
  profileImg: String!
  regularExpenditures: [RegularExpenditure!]!
  socialId: String!
  todos: [BucketListTodo!]!
  updatedAt: DateTime!
}